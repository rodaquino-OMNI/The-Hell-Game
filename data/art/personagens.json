          "curvar": [{ "osso": "spine_02", "graus": [18, 0, 0] }, { "osso": "Head", "graus": [12, 0, 0] }],
          "nota": "derivado: caminhada a 0,8× com tronco e cabeça curvados (sem sangue, Art Bible §1.3)"
