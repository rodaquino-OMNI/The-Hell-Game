{
  "$comment": "Paleta THE HELL — fonte única dos tokens de cor (Art Bible §2). Valores em 5 bits por canal (0–31) = cor de 15 bits do PS1 (GDD-v0.2 §10.1). O hex é derivado (round(v*255/31)). Verificação: node tools/art/palette-check.mjs",
  "version": "0.3.0",
  "tokens": {
    "ui.bg":            { "rgb5": [2, 2, 3],    "uso": "fundo de menus" },
    "ui.panel":         { "rgb5": [4, 4, 6],    "uso": "molduras 9-slice, painéis" },
    "ui.text":          { "rgb5": [29, 28, 26], "uso": "texto principal (osso)" },
    "ui.text_dim":      { "rgb5": [19, 19, 20], "uso": "texto secundário" },
    "ui.accent":        { "rgb5": [31, 22, 6],  "uso": "foco de teclado, seleção" },
    "ui.danger":        { "rgb5": [31, 9, 5],   "uso": "alertas, vida baixa" },

    "world.fog":        { "rgb5": [3, 4, 6],    "uso": "névoa e fundo a 30 m" },
    "world.wall":       { "rgb5": [6, 6, 7],   "uso": "paredes (concreto frio)" },
    "world.ground":     { "rgb5": [6, 6, 5],    "uso": "chão" },

    "class.curandeiro": { "rgb5": [0, 19, 14],  "forma": "caduceu nas costas + capuz arredondado", "uso": "Curandeiro" },
    "class.mecanico":   { "rgb5": [28, 19, 0],  "forma": "chave inglesa grande + capacete com lanterna", "uso": "Mecânico" },
    "class.atacador":   { "rgb5": [10, 20, 31],  "forma": "ombros largos + bastão", "uso": "Atacador" },
    "class.batedor":    { "rgb5": [29, 28, 8],  "forma": "corpo esguio + cachecol esvoaçante", "uso": "Batedor (fase 4)" },
    "class.protetor":   { "rgb5": [26, 26, 29], "forma": "escudo redondo nas costas + corpo largo (armadura prata)", "uso": "Protetor (fase 4)" },

    "gen.pendente":     { "rgb5": [26, 12, 0],  "padrao": "feixe piscando lento (1 Hz)", "uso": "gerador não iniciado" },
    "gen.progresso":    { "rgb5": [30, 27, 6],  "padrao": "feixe pulsando (2 Hz)", "uso": "gerador em progresso" },
    "gen.pronto":       { "rgb5": [4, 24, 20],  "padrao": "feixe contínuo", "uso": "gerador pronto" },
    "gen.bonus":        { "rgb5": [29, 12, 27], "padrao": "feixe em espiral + losango", "uso": "gerador bônus" },

    "hunter.olhos":     { "rgb5": [31, 4, 2],   "uso": "olhos emissivos e telegraph (GDD §10.4)" },
    "hunter.espectro":  { "rgb5": [22, 23, 25], "forma": "alto e magro, cabeça alongada, braços longos", "uso": "Espectro (lançamento)" },
    "hunter.carcereiro":{ "rgb5": [20, 11, 4],  "forma": "largo, cabeça de gaiola, correntes", "uso": "O Carcereiro" },
    "hunter.lamento":   { "rgb5": [18, 12, 28],  "forma": "véu longo, sem pernas visíveis, cabeça inclinada", "uso": "O Lamento" },

    "fx.ameaca":        { "rgb5": [31, 9, 5],   "uso": "seta de ameaça na borda (GDD §12.1)" },
    "fx.preso":         { "rgb5": [31, 22, 6],  "uso": "marcador de aliado preso" }
  },
  "tests": {
    "cvd_groups": {
      "$comment": "membros de cada grupo precisam ser distinguíveis entre si em visão normal e nas 3 simulações (CIEDE2000 >= min_de2000)",
      "min_de2000": 12,
      "classes": ["class.curandeiro", "class.mecanico", "class.atacador", "class.batedor", "class.protetor"],
      "geradores": ["gen.pendente", "gen.progresso", "gen.pronto", "gen.bonus"],
      "cacadores": ["hunter.espectro", "hunter.carcereiro", "hunter.lamento"]
    },
    "contrast_text": {
      "$comment": "WCAG 2.2 1.4.3 — texto >= 4,5:1",
      "min": 4.5,
      "pairs": [["ui.text", "ui.bg"], ["ui.text", "ui.panel"], ["ui.text_dim", "ui.bg"], ["ui.text_dim", "ui.panel"], ["ui.accent", "ui.panel"], ["ui.danger", "ui.panel"]]
    },
    "contrast_nontext": {
      "$comment": "WCAG 2.2 1.4.11 — elementos gráficos >= 3:1 contra o fundo onde aparecem (névoa/parede)",
      "min": 3.0,
      "pairs": [
        ["class.curandeiro", "world.fog"], ["class.mecanico", "world.fog"], ["class.atacador", "world.fog"], ["class.batedor", "world.fog"], ["class.protetor", "world.fog"],
        ["class.curandeiro", "world.wall"], ["class.mecanico", "world.wall"], ["class.atacador", "world.wall"], ["class.batedor", "world.wall"], ["class.protetor", "world.wall"],
        ["gen.pendente", "world.fog"], ["gen.progresso", "world.fog"], ["gen.pronto", "world.fog"], ["gen.bonus", "world.fog"],
        ["hunter.olhos", "world.fog"], ["hunter.espectro", "world.fog"], ["hunter.carcereiro", "world.fog"], ["hunter.lamento", "world.fog"],
        ["fx.ameaca", "world.fog"], ["fx.preso", "world.fog"]
      ]
    }
  }
}
