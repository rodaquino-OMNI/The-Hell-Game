{
  "name": "the-hell",
  "version": "0.1.0",
  "private": true,
  "description": "THE HELL — terror assimétrico 1 contra 1 a 5 no navegador",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "tsx tools/data/build-data.ts",
    "build": "pnpm data && pnpm --filter @thehell/client build && pnpm --filter @thehell/server build",
    "dev": "pnpm data && pnpm --filter @thehell/client dev",
    "start": "node packages/server/dist/server.mjs",
    "test": "pnpm data && vitest run",
    "coverage": "pnpm data && vitest run --coverage",
    "typecheck": "pnpm data && tsc -b",
    "lint": "eslint .",
    "check:palette": "node tools/art/palette-check.mjs",
    "i18n:check": "tsx tools/i18n/check.ts",
    "a11y": "node tools/a11y/axe.mjs",
    "smoke:prototype": "node tools/prototype-smoke.cjs /tmp/prototype-smoke.png",
    "smoke": "node tools/smoke.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "maps:validate": "tsx tools/maps/validate.ts",
    "sim": "tsx tools/sim/run.ts",
    "sim:check": "tsx tools/sim/run.ts --check",
    "sim:baseline": "tsx tools/sim/run.ts --check --write-baseline",
    "sim:nightly": "tsx tools/sim/run.ts --nightly",
    "maps:browser-check": "pnpm data && node tools/maps/recast-browser-check.mjs",
    "visual": "node tools/visual/compare.mjs",
    "perf:budget": "node tools/perf/budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
